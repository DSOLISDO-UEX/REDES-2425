{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/Adapter.cpp",
                "${workspaceFolder}/src/FrameBuilder.cpp",
                "${workspaceFolder}/src/Sesion3.cpp",
                "${workspaceFolder}/src/linkLayer.a",
                "-o",
                "${workspaceFolder}/build/Project",                
                "-lpcap",
                "-pthread",
                "-fpermissive"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}